# Proyecto de Supabase. La publishable key es pública por diseño: viaja al
# browser y RLS es lo que protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Salta RLS: nunca lo expongas al browser ni lo commitees.
SUPABASE_SECRET_KEY=

# Correo saliente (Resend). La llave la inyecta la integración de Vercel;
# en local se baja con `vercel env pull`.
RESEND_API_KEY=

# Remitente. Sin dominio verificado en Resend, `onboarding@resend.dev` solo
# puede escribirle al dueño de la cuenta: sirve para probar, no para producción.
RESEND_FROM="CitaPedia <onboarding@resend.dev>"

# Puerta del cron de recordatorios. Vercel manda este valor como
# `Authorization: Bearer ...` en cada corrida. Sin él, el endpoint no abre.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
