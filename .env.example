# Proyecto de Supabase. La publishable key es pública por diseño: viaja al
# browser y RLS es lo que protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Salta RLS: nunca lo expongas al browser ni lo commitees.
SUPABASE_SECRET_KEY=

# Email de recordatorios (paso 6). Todavía no se usa.
RESEND_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
